# Gravity RSVP - Evolution API v2.3.7 on Render
#
# This is documentation only. Do not rename it to .env and commit real values.
# In Render, enter the two secret/runtime-derived values marked REQUIRED INPUT.

# -----------------------------------------------------------------------------
# REQUIRED INPUT: Render service URL
# Source: Render Dashboard > your Web Service. Copy its public onrender.com URL.
# First deployment can use the expected URL; correct it after Render provisions.
# -----------------------------------------------------------------------------
SERVER_URL=https://gravity-rsvp-evolution.onrender.com

# Render exposes this port publicly through its own HTTPS proxy.
SERVER_PORT=10000
SERVER_NAME=gravity-rsvp-evolution
SERVER_TYPE=http

# No browser calls Evolution directly; Apps Script is the API client.
SERVER_DISABLE_DOCS=true
SERVER_DISABLE_MANAGER=true
CORS_ORIGIN=https://gravity-rsvp.vercel.app
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=false

# -----------------------------------------------------------------------------
# REQUIRED INPUT: Supabase PostgreSQL Session pooler URI
# Source: Supabase Dashboard > project > Connect > Session pooler (port 5432).
# Replace [YOUR-PASSWORD], URL-encoding reserved characters in the password.
# Keep both schema=evolution_api and sslmode=require.
# Do NOT use a Supabase anon key, service-role key, project URL, or port 6543.
# -----------------------------------------------------------------------------
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=evolution_api&sslmode=require
DATABASE_CONNECTION_CLIENT_NAME=gravity_rsvp_evolution

# Store only the linked-device instance/session information needed by Evolution.
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_HISTORIC=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_IS_ON_WHATSAPP=false
DATABASE_DELETE_MESSAGE=false

# Render Free has no persistent Redis service in this design.
CACHE_REDIS_ENABLED=false
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=true
CACHE_LOCAL_TTL=86400

# -----------------------------------------------------------------------------
# REQUIRED SECRET: generated automatically by render.yaml.
# Source after deployment: Render > Web Service > Environment.
# If configuring manually, generate at least 32 random bytes yourself.
# Copy the final value to Apps Script as EVOLUTION_API_KEY.
# -----------------------------------------------------------------------------
AUTHENTICATION_API_KEY=RENDER_GENERATES_THIS_SECRET
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false

DEL_INSTANCE=false
DEL_TEMP_INSTANCES=false
CONFIG_SESSION_PHONE_CLIENT=Gravity RSVP
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30
LANGUAGE=en

LOG_LEVEL=ERROR,WARN,INFO
LOG_COLOR=true
LOG_BAILEYS=error
WEBSOCKET_ENABLED=false
WEBSOCKET_GLOBAL_EVENTS=false
TELEMETRY_ENABLED=false
S3_ENABLED=false

# Not Render variables: configure these in Apps Script Project Settings.
# EVOLUTION_BASE_URL=<same value as SERVER_URL>
# EVOLUTION_API_KEY=<same value as AUTHENTICATION_API_KEY>
# EVOLUTION_INSTANCE_NAME=gravity-rsvp
# WHATSAPP_DEFAULT_COUNTRY_CODE=91
# WHATSAPP_BATCH_SIZE=10
# WHATSAPP_TEST_NUMBER=919876543210
# APPS_SCRIPT_SHARED_SECRET=<same random secret as Vercel>

# Not Render variables: configure these in Vercel Project Environment Variables.
# APPS_SCRIPT_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
# APPS_SCRIPT_SHARED_SECRET=<same random secret as Apps Script>
